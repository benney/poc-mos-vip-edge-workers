# Copy to .env.local to enable live mode. .env.local is gitignored.
#
# MOS_TOKEN is a *publishable* token, not an sk_ secret key. It is handed to the browser
# and sent by the worker itself, exactly as it would be in production. Do not put an
# sk_ key here.
#
# A publishable token never sends the page, because the API only accepts `http` (and so
# `http.proxyOrigin`) from a secret key. The decision is therefore header, status and
# cookie ops only, never a transformed body. Authenticated routes use the public key
# scheme (`PublicBearer`) as of core 1.6.0.

MOS_HOST=https://api.monetizationos.com
MOS_SURFACE_SLUG=your-surface-slug
MOS_TOKEN=pk_test_yourpublishabletoken

# Optional. The worker derives the envs/ path segment from the token by default
# (`pk_test_abc` -> `test_abc`). Set this when that derivation is wrong for your org.
# It only affects custom endpoints (/mos-endpoints/*).
# MOS_ENVIRONMENT=test_abc

# Optional: fetch real origin HTML so live runs use a real page.
# ORIGIN_BASE=https://news.example.com

# Optional safety valve. Off by default: all MOS paths are proxied, so custom endpoints
# and authenticated routes can create real records. Set true to allow only
# /api/v1/surface-decisions.
# MOS_DECISIONS_ONLY=true
